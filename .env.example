# ── Zorunlu ──────────────────────────────────────────────────────────────────
# PostgreSQL bağlantı dizesi
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/newlife

# Admin panel giriş bilgileri (ilk kurulumda seed ile oluşturulur)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# JWT imzalama anahtarı — üretimde mutlaka güçlü ve benzersiz bir değer kullanın
JWT_SECRET=change-me-to-a-long-random-secret

# Canlı site adresi (https:// ile)
SITE_URL=http://localhost:3000

# ── İsteğe bağlı ─────────────────────────────────────────────────────────────
# HTTPS cookie ayarı (Docker / kendi sunucunuzda true yapın)
HTTPS_ENABLED=false

# Vercel Blob kullanılmıyorsa yerel dosya yükleme için gerekli değil
# Vercel'de otomatik algılanır

# Telegram bildirimleri
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# E-posta (SMTP) — randevu onay bildirimleri
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# İlk deploy'da veritabanı seed'i çalıştırmak için (Vercel build sonrası bir kez)
# RUN_DB_SEED=true
